# Application
APP_PORT=6600
ORIGIN=https://market.rentner.dev

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# Authentication
# Erzeugen: openssl rand -base64 32; bei Updates unverändert lassen.
AUTH_ENCRYPTION_KEY=CHANGE_ME

# Anbieter-Anmeldung (optional; nur vollständig konfigurierte Anbieter erscheinen)
# Callback je Anbieter: ${ORIGIN}/api/auth/google/callback (github, discord entsprechend)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# Optional. Private GitHub App restricted to Actions write on RentnerProxy/marketplace.
MARKETPLACE_CANDIDATE_GITHUB_APP_CLIENT_ID=
MARKETPLACE_CANDIDATE_GITHUB_APP_INSTALLATION_ID=
# Absolute container path to the read-only PEM file readable by UID 1000.
MARKETPLACE_CANDIDATE_GITHUB_APP_PRIVATE_KEY_FILE=
# Legacy fine-grained token. Used only when the GitHub App settings are absent.
MARKETPLACE_CANDIDATE_GITHUB_TOKEN=

# Backups
BACKUP_PATH=./backups

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Secrets mit $, # oder Leerzeichen in einfache Quotes setzen.
# SMTP_SECURE=false erzwingt STARTTLS. Den Absendernamen setzt das Image:
# @project:defaultName
# "RentnerProxy Marketplace". Passkey-Werte erben ORIGIN und die App-Defaults.
