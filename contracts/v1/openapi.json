            },
            "Revocation": {
                "$ref": "./contracts.schema.json#/$defs/Revocation"
            },
            "Catalog": {
                "$ref": "./contracts.schema.json#/$defs/Catalog"
            },
            "Candidate": {
                "$ref": "./contracts.schema.json#/$defs/Candidate"
            },
            "Approval": {
                "$ref": "./contracts.schema.json#/$defs/Approval"
            },
            "Publication": {
                "$ref": "./contracts.schema.json#/$defs/Publication"
            },
            "RecordId": {
                "$ref": "./contracts.schema.json#/$defs/RecordId"
            },
            "Generation": {
                "$ref": "./contracts.schema.json#/$defs/Generation"
            },
            "BootstrapDescriptor": {
                "$ref": "./contracts.schema.json#/$defs/BootstrapDescriptor"
            },
            "AppHealth": {
                "$ref": "./contracts.schema.json#/$defs/AppHealth"
            },
            "AppReadiness": {
                "$ref": "./contracts.schema.json#/$defs/AppReadiness"
            },
            "PlatformContext": {
                "$ref": "./contracts.schema.json#/$defs/PlatformContext"
            },
            "AuthorizationRequest": {
                "$ref": "./contracts.schema.json#/$defs/AuthorizationRequest"
            },
            "AuthorizationResult": {
                "$ref": "./contracts.schema.json#/$defs/AuthorizationResult"
            },
            "EventCursor": {
                "$ref": "./contracts.schema.json#/$defs/EventCursor"
            },
            "PlatformEvent": {
                "$ref": "./contracts.schema.json#/$defs/PlatformEvent"
            },
            "ProviderRegistration": {
                "$ref": "./contracts.schema.json#/$defs/ProviderRegistration"
            },
            "ProviderRequest": {
                "$ref": "./contracts.schema.json#/$defs/ProviderRequest"
            },
            "ProviderResult": {
                "$ref": "./contracts.schema.json#/$defs/ProviderResult"
            },
            "UiBridgeMessage": {
                "$ref": "./contracts.schema.json#/$defs/UiBridgeMessage"
            },
            "Problem": {
                "$ref": "./contracts.schema.json#/$defs/Problem"
            },
            "Operation": {
