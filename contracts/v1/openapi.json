{
    "openapi": "3.1.2",
    "info": {
        "title": "RentnerProxy App Protocol Preview",
        "version": "1.0.0-alpha.2",
        "description": "Preview contract for native apps. HTTP uses the declared private Unix socket for each operation. Platform authorization is required at the runtime boundary. Package and publication records use the matching SDK for cross-record checks."
    },
