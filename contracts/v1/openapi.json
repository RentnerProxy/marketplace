                    {
                        "AppCredential": []
                    }
                ],
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Installation"
                    },
                    {
                        "$ref": "#/components/parameters/Generation"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The app process is healthy.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AppHealth"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "The request credential is absent or invalid.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The installation, generation, actor, or resource is unauthorized.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The app is unhealthy.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "The request failed with a stable problem code.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                }
            }
        },
