        "/platform/v1/events": {
            "get": {
                "operationId": "subscribeToEvents",
                "summary": "Resume the permission-filtered durable stream",
                "x-rentnerproxy-socket": "core.sock",
                "security": [
                    {
                        "CoreCredential": []
                    }
                ],
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Installation"
                    },
                    {
                        "$ref": "#/components/parameters/Generation"
                    },
                    {
                        "$ref": "#/components/parameters/Delegation"
                    },
                    {
                        "$ref": "#/components/parameters/ResumeCursor"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Server-Sent Events with at-least-once delivery. The SSE id is the resume cursor. Deduplicate JSON payloads by their event id. Recheck the active generation, current grants, resource visibility, and delegation at delivery. Close the stream when subscription authority expires or is revoked.",
                        "content": {
                            "text/event-stream": {
                                "schema": {
                                    "type": "string"
                                },
                                "x-rentnerproxy-event-data-schema": {
                                    "$ref": "#/components/schemas/PlatformEvent"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "The request credential is absent or invalid.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
