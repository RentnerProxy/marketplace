                        "description": "The installation, generation, actor, or resource is unauthorized.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "410": {
                        "description": "The cursor expired. Perform a full authorized resynchronization.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "The request failed with a stable problem code.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "x-rentnerproxy-rpc-limits": {
        "maxJsonBytes": 1048576,
        "maxListEntries": 100,
        "defaultDeadlineMs": 10000,
        "maxDeadlineMs": 30000
    },
    "components": {
        "securitySchemes": {
            "AppCredential": {
                "type": "http",
                "scheme": "bearer",
                "description": "The manager-issued app direction credential. The platform verifies the app peer UID before calling it. The app validates the credential and generation."
            },
            "CoreCredential": {
                "type": "http",
                "scheme": "bearer",
                "description": "The manager-issued core direction credential. The platform validates the Linux peer UID and credential on each request and authorizes the installation generation for the requested operation."
            }
        },
        "parameters": {
            "Installation": {
                "name": "X-App-Installation",
                "in": "header",
                "required": true,
                "schema": {
                    "$ref": "#/components/schemas/RecordId"
                }
            },
            "Generation": {
                "name": "X-App-Generation",
                "in": "header",
                "required": true,
                "description": "Positive installation generation in canonical decimal form.",
                "schema": {
                    "$ref": "#/components/schemas/Generation"
                }
            },
            "Delegation": {
                "name": "X-App-Delegation",
                "in": "header",
                "description": "The platform-issued opaque delegation is required for user-originated work. An explicit service grant governs autonomous operations.",
                "schema": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{16,256}$"
                }
            },
            "IdempotencyKey": {
                "name": "Idempotency-Key",
                "in": "header",
                "required": true,
                "description": "Retry the same input with the original key. Reusing the key with different input conflicts.",
                "schema": {
                    "$ref": "#/components/schemas/RecordId"
                }
            },
            "OperationId": {
                "name": "operationId",
                "in": "path",
                "required": true,
                "schema": {
                    "$ref": "#/components/schemas/RecordId"
                }
            },
            "ResumeCursor": {
                "name": "Last-Event-ID",
                "in": "header",
                "description": "Resume within the subscription authorized by the current generation, grants, and delegation.",
                "schema": {
                    "$ref": "#/components/schemas/EventCursor"
                }
            }
        },
        "schemas": {
            "SourceIdentity": {
                "$ref": "./contracts.schema.json#/$defs/SourceIdentity"
            },
            "AppManifest": {
                "$ref": "./contracts.schema.json#/$defs/AppManifest"
            },
            "PackageArtifact": {
                "$ref": "./contracts.schema.json#/$defs/PackageArtifact"
            },
            "CatalogRelease": {
