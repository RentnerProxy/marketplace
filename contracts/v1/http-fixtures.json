                "digest": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
                "partCount": 2
            },
            "valid": true
        },
        {
            "title": "a legacy handoff begin rejects unknown members",
            "operation": "beginLegacyHandoff",
            "status": 200,
            "body": {
                "domain": "docker-discovery",
                "state": "exported",
                "digest": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
                "partCount": 2,
                "installationId": "install-1"
            },
            "valid": false
        },
        {
            "title": "a legacy handoff begin reports another holder as a conflict",
            "operation": "beginLegacyHandoff",
            "status": 409,
            "body": {
                "type": "urn:rentnerproxy:problem:conflict",
                "title": "App operation conflicts with current state.",
                "status": 409,
                "code": "conflict",
                "requestId": "request-1"
            },
            "valid": true
        },
        {
            "title": "a legacy handoff part returns its sequence and content",
            "operation": "readLegacyHandoffPart",
            "status": 200,
            "body": {
                "sequence": 1,
                "part": { "monitors": [{ "id": "monitor-1" }] }
            },
            "valid": true
        },
        {
            "title": "a legacy handoff part rejects a sequence beyond the journal",
            "operation": "readLegacyHandoffPart",
            "status": 200,
            "body": { "sequence": 1024, "part": {} },
            "valid": false
        },
        {
            "title": "a legacy handoff part reports an unknown sequence",
            "operation": "readLegacyHandoffPart",
            "status": 404,
            "body": {
                "type": "urn:rentnerproxy:problem:notFound",
                "title": "App resource is unavailable.",
                "status": 404,
                "code": "notFound",
                "requestId": "request-1"
            },
            "valid": true
        },
        {
            "title": "a legacy handoff part reports an unreadable part",
            "operation": "readLegacyHandoffPart",
            "status": 503,
            "body": {
                "type": "urn:rentnerproxy:problem:unavailable",
                "title": "App API is unavailable.",
                "status": 503,
                "code": "unavailable",
                "requestId": "request-1"
            },
            "valid": true
        },
        {
            "title": "a legacy handoff commit transfers ownership",
            "operation": "commitLegacyHandoff",
            "status": 200,
            "body": {
                "domain": "crowdsec",
                "state": "committed",
                "digest": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
            },
            "valid": true
        },
        {
            "title": "a legacy handoff commit rejects a part count after ownership moved",
            "operation": "commitLegacyHandoff",
            "status": 200,
            "body": {
                "domain": "crowdsec",
                "state": "committed",
                "digest": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
                "partCount": 2
            },
            "valid": false
        },
        {
            "title": "a legacy handoff commit rejects a domain outside the provider profiles",
            "operation": "commitLegacyHandoff",
            "status": 200,
            "body": {
                "domain": "proxy-hosts",
                "state": "committed",
                "digest": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
            },
            "valid": false
        },
        {
            "title": "a legacy handoff commit reports a digest mismatch as a conflict",
            "operation": "commitLegacyHandoff",
            "status": 409,
            "body": {
                "type": "urn:rentnerproxy:problem:conflict",
                "title": "App operation conflicts with current state.",
                "status": 409,
                "code": "conflict",
                "requestId": "request-1"
            },
            "valid": true
        }
    ],
    "events": [
        {
            "title": "a decoded event validates against its own schema",
            "operation": "subscribeToEvents",
            "body": {
                "id": "event-1",
                "cursor": "Cursor_01",
                "type": "proxyHostChanged",
                "occurredAt": "2026-11-17T10:00:00.000Z",
                "resourceId": "host-1",
                "revision": "revision-1"
            },
            "valid": true
        },
        {
            "title": "an event requires its resume cursor",
            "operation": "subscribeToEvents",
            "body": {
                "id": "event-1",
                "type": "proxyHostChanged",
                "occurredAt": "2026-11-17T10:00:00.000Z"
            },
            "valid": false
        },
        {
            "title": "a nonstreaming operation cannot validate events",
            "operation": "getAppReadiness",
            "body": {
                "id": "event-1",
                "cursor": "Cursor_01",
                "type": "proxyHostChanged",
                "occurredAt": "2026-11-17T10:00:00.000Z"
