# Lokale Entwicklung ohne Docker Compose
# Kopieren: cp .env.dev.example .env.local
# Werte mit # oder Leerzeichen bei Bedarf in einfache Quotes setzen.

# App und Datenbank
ORIGIN=http://localhost:3000
VITE_APP_VERSION=Dev
# @project:databaseName
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@127.0.0.1:5432/rentnerproxy_marketplace

# Valkey wird für Queues, Rate-Limits, Realtime und den Setup-Zugang benötigt.
# Der Client verwendet das kompatible Protokoll redis:// beziehungsweise rediss://.
VALKEY_URL=redis://127.0.0.1:6379
# Optional; überschreibt den Passwortanteil aus VALKEY_URL URL-sicher.
VALKEY_PASSWORD=

# Erzeugen: openssl rand -base64 32
# Stabil halten: ein Wechsel macht vorhandene TOTP- und Queue-Daten unlesbar.
AUTH_ENCRYPTION_KEY=

# Lokale Persistenz und Backups
APP_STORAGE_DIR=./public
APP_PRIVATE_STORAGE_DIR=./storage-data/private
BACKUP_DIR=./backups
BACKUP_TIMEZONE=Europe/Berlin
# Erlaubt: 60 bis 14400; leer verwendet 7200 Sekunden.
BACKUP_POSTGRES_TIMEOUT_SECONDS=
# Optional unter Windows, wenn pg_dump/pg_restore nicht im PATH liegen.
POSTGRES_BIN_DIR=

# SMTP-Mailversand
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS, true = implizites TLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# @project:defaultName
MAIL_FROM_NAME=`RentnerProxy Marketplace`

# Passkeys; leer übernimmt ORIGIN, dessen Host und den App-Standardnamen.
PASSKEY_ORIGIN=
PASSKEY_RP_ID=
PASSKEY_RP_NAME=

# Reverse-Proxy-Header lokal standardmäßig nicht vertrauen.
TRUST_PROXY_HEADERS=false
# Nur bei TRUST_PROXY_HEADERS=true erforderlich; kommaseparente CIDR/IP-Liste.
TRUSTED_PROXY_RANGES=

# Lokaler Realtime-Server
REALTIME_WS_HOST=127.0.0.1
REALTIME_WS_PORT=3001
VITE_REALTIME_WS_DEV_PORT=3001
# Optionaler vollständiger Browser-Override, z. B. ws://localhost:3001/ws.
VITE_REALTIME_WS_URL=
# Nur erforderlich, wenn der Dev-Realtime-Server außerhalb Loopback lauscht.
REALTIME_PUBLISH_SECRET=
