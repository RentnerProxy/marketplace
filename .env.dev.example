# Lokale Entwicklung: cp .env.dev.example .env.local
ORIGIN=http://localhost:3000

# Optional: OAuth apps use ${ORIGIN}/api/auth/<provider>/callback.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
# @project:databaseName
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@127.0.0.1:5432/rentnerproxy_marketplace
VALKEY_URL=redis://127.0.0.1:6379

# Erzeugen: openssl rand -base64 32; für bestehende Daten unverändert lassen.
AUTH_ENCRYPTION_KEY=

# Öffentliche Uploads werden vom Vite-Dev-Server aus web/public ausgeliefert.
APP_STORAGE_DIR=./web/public
APP_PRIVATE_STORAGE_DIR=./storage-data/private
BACKUP_DIR=./backups
