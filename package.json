{
    "name": "rentnerproxy-marketplace",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "dev": "bun run core:build && bun run project:check && bun run --parallel dev:core dev:web dev:realtime worker:dev",
        "dev:web": "bunx --bun vite dev --port 3000",
        "dev:realtime": "bun run web/src/server/realtimeDevServer.ts",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test": "bun run core:tools:build && bun run --no-env-file web/src/scripts/test-coverage.ts",
        "contracts:generate": "bun run core:tooling:build && bun run --no-env-file web/src/scripts/Contracts/generate-contracts.ts",
        "contracts:check": "bun run core:tooling:build && bun run --no-env-file web/src/scripts/Contracts/generate-contracts.ts --check",
        "test:deployment": "bun run core:tooling:build && bun run --no-env-file web/src/scripts/verify-appliance.ts",
        "verify": "bun run core:format:check && bun run core:lint && bun run core:coverage && bun run core:build && bun run project:check && bun run contracts:check && bun run typecheck && bun run test && bun run test:core-integration && bun run lint && bun run format:check && bun run build",
        "test:db:prepare": "bun run core:tooling:build && bun run web/src/scripts/prepare-test-database.ts",
        "test:db": "bun run core:tooling:build && bun test --isolate --timeout 30000 --preload ./web/src/tests/shared/setupDbTests.ts --path-ignore-patterns __never_match_bun_db_tests__ .db.test.ts",
        "start": "bun run web/src/server/productionEntrypoint.ts",
        "worker": "bun run web/src/server/productionWorkerEntrypoint.ts",
        "worker:dev": "bun --watch run web/src/server/backgroundWorker.ts",
        "worker:healthcheck": "bun run web/src/server/workerHealthcheck.ts",
        "setup:production": "bun run web/src/server/SystemBootstrap/initialize-production.ts",
        "setup:url": "bun run web/src/server/SystemBootstrap/create-first-super-user-setup-url.ts",
        "project:sync": "bun run core:tooling:build && bun run --no-env-file web/src/scripts/project-sync.ts",
        "project:check": "bun run core:tooling:build && bun run --no-env-file web/src/scripts/project-sync.ts --check",
        "starter:audit": "bun run project:check && bun run --no-env-file web/src/scripts/starter-audit.ts",
        "permissions:sync": "bun run web/src/scripts/sync-permissions.ts",
        "db:generate": "bunx drizzle-kit generate",
        "db:migrate": "bun run web/src/db/migrate.ts",
        "db:push": "bunx drizzle-kit push",
        "db:pull": "bunx drizzle-kit pull",
        "db:studio": "bunx drizzle-kit studio",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "format": "bun fmt .",
        "format:check": "bun fmt --check .",
        "core:build": "bun run --no-env-file web/src/scripts/core-tooling.ts build && bun run core:tools:build",
        "core:tools:build": "bun run --no-env-file web/src/scripts/core-tooling.ts tools-build",
        "core:tooling:build": "bun run --no-env-file web/src/scripts/core-tooling.ts tooling-build",
        "core:catalog:build": "bun run --no-env-file web/src/scripts/core-tooling.ts catalog-build",
        "core:check": "bun run --no-env-file web/src/scripts/core-tooling.ts check",
        "core:test": "bun run --no-env-file web/src/scripts/core-tooling.ts test",
        "core:coverage": "bun run --no-env-file web/src/scripts/core-tooling.ts coverage",
        "core:lint": "bun run --no-env-file web/src/scripts/core-tooling.ts lint",
        "core:format": "bun run --no-env-file web/src/scripts/core-tooling.ts format",
        "core:format:check": "bun run --no-env-file web/src/scripts/core-tooling.ts format:check",
        "dev:core": "bun run --no-env-file web/src/scripts/core-tooling.ts serve",
        "test:core-integration": "bun --no-env-file test --isolate --timeout 30000 --path-ignore-patterns __no_ignored_core_tests__ .core.test.ts",
        "test:catalog-integration": "bun --no-env-file test --isolate --path-ignore-patterns __no_ignored_catalog_tests__ app-catalog.integration.test.ts"
    },
    "dependencies": {
        "@rentnerkev/calendar": "^2.10.1",
        "@rentnerkev/inputs": "^2.8.2",
        "@rentnerkev/picker": "^2.4.1",
        "@rentnerkev/select": "^6.2.0",
        "@rentnerkev/table": "^1.4.1",
        "@rentnerkev/toasts": "^3.9.0",
        "@rentnerkev/tooltips": "^2.3.2",
        "@simplewebauthn/browser": "^14.0.0",
        "@simplewebauthn/server": "^14.1.0",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.108.2",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.169.7",
        "@tanstack/react-table": "^9.3.1",
        "bullmq": "^6.7.8",
        "drizzle-orm": "^0.45.4",
        "i18next": "^27.2.3",
        "i18next-resources-to-backend": "^1.3.0",
        "ioredis": "^6.0.0",
        "jose": "^6.2.18",
        "lucide-react": "^1.77.0",
        "motion": "^14.14.0",
        "nodemailer": "^10.6.1",
        "openid-client": "^6.9.1",
        "otpauth": "^9.6.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-easy-crop": "^6.2.5",
        "sharp": "^0.35.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@electric-sql/pglite": "0.5.17",
        "@faker-js/faker": "^10.6.0",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/devtools-vite": "^0.8.7",
        "@tanstack/react-devtools": "^0.10.15",
        "@tanstack/react-query-devtools": "^5.108.2",
        "@tanstack/react-router-devtools": "^1.167.4",
        "@types/bun": "^1.4.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "drizzle-kit": "^0.31.11",
        "nitro": "^3.0.261103-rc",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2008",
        "tailwindcss": "^4.3.5",
        "tar-stream": "^3.2.2",
        "typescript": "7.0.2",
        "vite": "^8.3.8"
    },
    "overrides": {
        "@esbuild-kit/core-utils>esbuild": "0.28.2"
    },
    "patchedDependencies": {
        "picomatch@4.0.7": "patches/picomatch@4.0.7.patch"
    }
}
